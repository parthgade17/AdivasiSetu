# ===== Copy to .env =====
# Frontend dev only (npm run dev). Leave empty when the backend serves the UI (Docker/production).
VITE_API_URL=http://localhost:8000

# ===== Backend =====
APP_ENV=production            # development | production
DEMO_MODE=false               # true = demo accounts, fixed OTP 123456 for them, reset endpoint, "advance status" button
SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets;print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=change-this-password         # used by docker compose

# Who may sign in as admin / CSC operator outside demo mode (comma separated 10-digit numbers)
ADMIN_PHONES=9XXXXXXXXX
ASSISTANT_PHONES=

# SMS for OTP: console (prints OTP in server log, for testing) | msg91 | twilio
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Only needed if the frontend is hosted on a different domain than the API
CORS_ORIGINS=
# DATABASE_URL=postgresql://user:pass@host:5432/db   (set automatically by docker compose)
# UPLOAD_DIR=uploads   MAX_UPLOAD_MB=5   SESSION_DAYS=30   DIGILOCKER_MODE=mock
